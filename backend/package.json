{
  "name": "nice-gadgets-store-backend",
  "private": true,
  "version": "0.1.0",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "prisma:generate": "PRISMA_ENGINES_CACHE_DIR=./.prisma-cache prisma generate",
    "prisma:migrate": "PRISMA_ENGINES_CACHE_DIR=./.prisma-cache prisma migrate dev",
    "prisma:studio": "PRISMA_ENGINES_CACHE_DIR=./.prisma-cache prisma studio",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "prisma": "^7.4.1",
    "tsx": "^4.21.0"
  }
}
