// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id              String    @id @default(cuid())
  name            String  
  slug            String    @unique
  createdAt       DateTime  @default(now())

  products Product[]
}

model ProductDetails {
  id               String   @id @default(cuid())
  category         String
  namespaceId      String
  name             String
  capacityAvailable Json
  capacity         String
  priceRegular     Int
  priceDiscount    Int
  colorsAvailable  String[]
  color            String
  images           Json
  description      Json
  screen           String
  resolution       String
  processor        String
  ram              String
  camera           String?
  zoom             String?
  cell             Json
  itemId           String @unique

  product          Product @relation(fields: [itemId], references: [itemId], onDelete: Cascade)
}

model Product {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  itemId           String    @unique
  fullPrice        Int
  price            Int
  screen           String
  capacity         String
  color            String
  ram              String
  year             Int
  images           Json 
  details          ProductDetails?
  stock            Int
  categoryId       String
  category         Category  @relation(fields: [categoryId], references: [id])
  createdAt        DateTime  @default(now())
}
